PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusgigs
JWT_SECRET=change_this_to_a_long_random_string
# comma separated list of allowed email domains
ALLOWED_DOMAINS=ves.ac.in
# percent kept by the platform when escrow is released (0 = freelancer gets 100%, blueprint default = 5)
SERVICE_FEE_PERCENT=0
# demo wallet settings (1 GigCoin = Rs 1)
SIGNUP_BONUS_COINS=500
MIN_WITHDRAW_COINS=50
# analytics are bucketed in this timezone
APP_TIMEZONE=Asia/Kolkata
CLIENT_ORIGIN=http://localhost:5173
# set to true if your Postgres host needs SSL (Neon, Render, Supabase)
DB_SSL=false
